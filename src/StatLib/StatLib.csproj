<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	<EmbeddedResource Include="../Stat/*.csv" > <!-- When build happens, takes every .csv file in the Stat folder -->
		<LogicalName>StatLib.Stat.%(Filename)%(Extension)</LogicalName>
	</EmbeddedResource>
  </ItemGroup>

</Project>
